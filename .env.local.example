# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает (см. .gitignore).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для входа в /admin (придумайте свой)
ADMIN_PASSWORD=

# Этап 3: FusionBrain (Kandinsky) — пока не используются
FUSIONBRAIN_API_KEY=
FUSIONBRAIN_SECRET_KEY=
